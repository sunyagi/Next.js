# Copy to .env and fill in. Never commit real credentials.
TL_ENVIRONMENT=https://demo.tradelocker.com   # https://live.tradelocker.com for real money
TL_EMAIL=you@example.com
TL_PASSWORD=your-password
TL_SERVER=YOUR-BROKER-SERVER                  # shown on the TradeLocker login screen
TL_ACC_NUM=0                                  # 0 = first account; see the account list in TradeLocker
